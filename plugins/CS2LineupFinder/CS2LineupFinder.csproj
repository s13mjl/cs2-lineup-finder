<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CS2LineupFinder</AssemblyName>
    <RootNamespace>CS2LineupFinder.Plugin</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  <!-- The shared contracts ship as CS2LineupFinder.Abstractions.dll next to the
       plugin, so Core and Math (which reference the same assembly) and the
       plugin all see one interface type at runtime. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- A CSSharp plugin is a single drop-in DLL, so the shared contracts are
         compiled in rather than shipped as a second assembly. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\contracts\CS2LineupFinder.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
<PackageReference Include="CounterStrikeSharp.API" Version="1.0.368" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Templates deployed next to the compiled plugin by the release workflow. -->
    <None Include="config\config.toml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's configuration property is internal so the engine type stays out
         of the public surface; the test project is the only friend. -->
    <InternalsVisibleTo Include="CS2LineupFinder.Plugin.Tests" />
  </ItemGroup>

</Project>
